token: {{ k3s_token | to_json }}
cluster-init: true
node-ip: {{ ansible_host | to_json }}
tls-san:
  - {{ ansible_host | to_json }}
secrets-encryption: true
disable:
{% for component in k3s_disable %}
  - {{ component | to_json }}
{% endfor %}
write-kubeconfig-mode: "0600"
kubelet-arg:
  - "image-gc-high-threshold=80"
  - "image-gc-low-threshold=60"
